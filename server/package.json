{
  "name": "url-shortener-server",
  "version": "1.0.0",
  "private": true,
  "description": "API, redirecciones y worker de analíticas del acortador de URLs",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "worker": "node src/worker.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
