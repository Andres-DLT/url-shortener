# Copia este fichero a .env (en la raíz o en server/) y ajústalo.

PORT=3000
# URL pública con la que se construyen los enlaces cortos (sin barra final).
BASE_URL=http://localhost:3000

DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener
REDIS_URL=redis://localhost:6379

# Sal secreta para anonimizar IPs (hash SHA-256). Cámbiala en producción.
IP_HASH_SALT=cambia-esta-sal-en-produccion

# Proxies de confianza delante de la app (Nginx, Cloudflare, balanceador…) para leer
# la IP real de X-Forwarded-For: 0 = conexión directa, un número de saltos o "true".
TRUST_PROXY=0

# Contraseña de administración (crear, editar y borrar enlaces).
# Sin ella: en desarrollo todo queda abierto; con NODE_ENV=production la gestión se bloquea.
ADMIN_PASSWORD=
# true: cualquiera puede ver el panel en solo lectura. false: también hace falta sesión para verlo.
PUBLIC_DASHBOARD=true
# Secreto para firmar la cookie de sesión (opcional; por defecto se deriva de ADMIN_PASSWORD).
# SESSION_SECRET=
# Carga enlaces de demostración al arrancar si la base de datos está vacía.
SEED_DEMO_ON_EMPTY=false

# true: el worker de clics corre dentro del proceso web (cómodo en desarrollo).
# false: arráncalo aparte con `npm run worker` (recomendado en producción).
RUN_WORKER_INLINE=true

# Opcionales
# CODE_LENGTH=7
# LINK_CACHE_TTL=3600
# STATS_CACHE_TTL=60
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX_CREATES=30
# WORKER_BATCH_SIZE=500
# WORKER_BLOCK_MS=2000
